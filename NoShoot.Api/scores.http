@baseUrl = http://localhost:5031
@token = COLE_AQUI_O_TOKEN_DO_ANDRENC1
@token2 = COLE_AQUI_O_TOKEN_DA_MARIA

### 1. Cadastrar andrenc1 (201)
POST {{baseUrl}}/api/players
Content-Type: application/json

{ "name": "andrenc1" }

### 2. Mesmo nome com outras maiusculas (409)
POST {{baseUrl}}/api/players
Content-Type: application/json

{ "name": "ANDRENC1" }

### 3. Nome invalido (400)
POST {{baseUrl}}/api/players
Content-Type: application/json

{ "name": "ab" }

### 4. Cadastrar maria (201)
POST {{baseUrl}}/api/players
Content-Type: application/json

{ "name": "maria" }

### 5. Partida do andrenc1 (201)
POST {{baseUrl}}/api/scores
Authorization: Bearer {{token}}
Content-Type: application/json

{ "kills": 62, "survivedSeconds": 50 }

### 6. Outra partida do andrenc1, melhor (201)
POST {{baseUrl}}/api/scores
Authorization: Bearer {{token}}
Content-Type: application/json

{ "kills": 80, "survivedSeconds": 100 }

### 7. Partida da maria (201)
POST {{baseUrl}}/api/scores
Authorization: Bearer {{token2}}
Content-Type: application/json

{ "kills": 70, "survivedSeconds": 150 }

### 8. Sem token (401)
POST {{baseUrl}}/api/scores
Content-Type: application/json

{ "kills": 10, "survivedSeconds": 60 }

### 9. Token falso (401)
POST {{baseUrl}}/api/scores
Authorization: Bearer tokenfalso123
Content-Type: application/json

{ "kills": 10, "survivedSeconds": 60 }

### 10. Ranking
GET {{baseUrl}}/api/scores/top

### 11. Uma partida pelo id
GET {{baseUrl}}/api/scores/1